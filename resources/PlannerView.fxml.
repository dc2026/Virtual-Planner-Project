<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="20.0" 
      xmlns:fx="http://javafx.com/fxml/1" 
      xmlns="http://javafx.com/javafx/21"
      fx:controller="PlannerController"> <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="New Task Title:" />
        <TextField fx:id="titleInput" promptText="Enter task title" HBox.hgrow="ALWAYS" />
        <Button fx:id="addTaskButton" text="Add Task" onAction="#handleAddTask" />
    </HBox>

    <Label fx:id="statusMessage" text="Ready." />

    <TableView fx:id="taskTable" VBox.vgrow="ALWAYS">
        </TableView>

</VBox>